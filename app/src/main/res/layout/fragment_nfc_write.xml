<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/app_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/NexTapToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:title="Write NFC" app:navigationIcon="@drawable/ic_arrow_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="520dp" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
            <ImageView android:id="@+id/state_icon" android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_nfc" android:contentDescription="NFC" android:padding="12dp" android:layout_marginTop="22dp" />
            <TextView android:id="@+id/headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready to write" android:textAlignment="center" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="18dp" />
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hold the NFC card near the back of your phone." android:textAlignment="center" android:textColor="@color/text_secondary" android:textSize="16sp" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_stat_card" android:padding="12dp" android:text="NFC reader starting…" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="12sp" />
            <ProgressBar android:id="@+id/progress" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="20dp" />
            <com.google.android.material.card.MaterialCardView style="@style/DetailCard" android:layout_marginTop="22dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/card_uid" style="@style/DetailText" />
                    <TextView android:id="@+id/customer" style="@style/DetailText" />
                    <TextView android:id="@+id/url" style="@style/DetailText" android:textIsSelectable="true" android:maxLines="2" android:ellipsize="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/retry_button" android:layout_width="match_parent" android:layout_height="54dp" android:text="Try again" android:textStyle="bold" android:layout_marginTop="22dp" android:visibility="gone" app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/done_button" android:layout_width="match_parent" android:layout_height="54dp" android:text="Done" android:textStyle="bold" android:layout_marginTop="10dp" android:visibility="gone" app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
