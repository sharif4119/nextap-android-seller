<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NFCWritter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/surface_soft</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.NFCWritter" parent="Base.Theme.NFCWritter" />

    <style name="StatText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@color/surface_soft</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="DetailText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
